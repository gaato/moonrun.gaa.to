{
	"name": "moonrun-gaa-to",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"author": "Gakuto Furuya",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/prepare-moonrun.ts && node scripts/prepare-commands.ts && vite dev",
		"build": "node scripts/prepare-moonrun.ts && node scripts/prepare-commands.ts && vite build && node scripts/write-security-headers.ts && node scripts/check-artifacts.ts",
		"prepare:commands": "node scripts/prepare-commands.ts",
		"preview": "vite preview",
		"smoke": "node scripts/smoke-worker.ts",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"verify": "pnpm check && pnpm lint && pnpm test && pnpm build"
	},
	"dependencies": {
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"fflate": "^0.8.3",
		"moonrun-js": "^0.1.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"daisyui": "^5.7.50",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.0"
	}
}
